<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/ivManagedDeviceIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@android:drawable/ic_menu_manage"
        android:contentDescription="@string/desc_managed_device_icon" />

    <TextView
        android:id="@+id/tvManagedDeviceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_gravity="center_vertical"
        android:text="@string/item_managed_device_default_name"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnBoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_boot"
        android:layout_marginEnd="4dp" />

    <Button
        android:id="@+id/btnShutdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_shutdown"
        android:layout_marginEnd="4dp" />

    <Button
        android:id="@+id/btnRemove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_remove" />

</LinearLayout>
